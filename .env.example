# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) and secret key (sb_secret_...) from Project Settings -> API Keys.
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are still accepted as fallbacks.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mailgun (Sending -> Domains / API keys)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Ego Olisa Enterprises <orders@YOUR_MAILGUN_DOMAIN>"
# Use https://api.eu.mailgun.net for EU-region domains
MAILGUN_API_BASE=https://api.mailgun.net
# Optional: copy of every order email to the shop owner
SHOP_OWNER_EMAIL=

# Paystack (Dashboard -> Settings -> API Keys & Webhooks). Server-side only; no public key needed.
# Leave blank to hide the "Pay online" option at checkout.
PAYSTACK_SECRET_KEY=

# Shown in the bank-transfer email
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Viewing bookings
# Inspection fee per viewing in kobo (default 2000000 = NGN 20,000). Set 0 for no fee.
INSPECTION_FEE_KOBO=2000000
# How many viewings can share one hourly slot (default 2)
BOOKING_SLOT_CAPACITY=2
# Shared secret for the Supabase Database Webhook that triggers booking approve/decline emails.
# Generate a long random string; the same value goes in the webhook's x-webhook-secret header.
BOOKING_WEBHOOK_SECRET=

# Public contact details (placeholders are used when blank)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
